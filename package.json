{
  "name": "@automerge/automerge-repo-keyhive",
  "version": "0.1.0-alpha.18d",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "watch": "tsc --watch",
    "lint": "npx prettier --check \"** /*.js\" --check \"**/*.ts\"; echo \"Run pnpm lint:fix to fix\"",
    "lint:fix": "npx prettier --write \"** /*.js\" --write \"**/*.ts\"",
    "bench": "vitest bench",
    "bench:extract": "npx tsx bench/extract-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@automerge/automerge-repo": "2.5.3",
    "@automerge/automerge-repo-network-websocket": "2.5.3",
    "@keyhive/keyhive": "0.0.0-alpha.55b",
    "cbor-x": "^1.6.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@noble/ed25519": "^3.0.0",
    "@types/debug": "^4.1.12",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.5.0",
    "globals": "^15.0.0",
    "typescript": "^5.2",
    "vitest": "^1.6.0"
  }
}
